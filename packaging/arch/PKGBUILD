# Vela come pacchetto di Arch / CachyOS, dal repository git.
#
#   cd packaging/arch && makepkg -si      installa
#   vela-update                           poi aggiorna (vedi vela-update --help)
#
# Il sorgente è il repository su GitHub (privato: serve la chiave SSH del
# proprio account). Per costruire da una copia locale, anche con modifiche
# non ancora pubblicate ma già nei commit:
#
#   VELA_GIT_URL=file:///percorso/di/vela makepkg -si
#
# La versione viene dal progetto e dai commit (0.1.0.r123.gabcdef0): ogni
# commit nuovo è un aggiornamento.

pkgname=vela-git
_name=vela
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="A modern, fluid and sharp desktop environment for Wayland"
arch=('x86_64')
url="https://github.com/BrandoDev/vela"
license=('GPL-3.0-or-later')
depends=(
    'wlroots0.20' 'wayland' 'libxkbcommon' 'pixman' 'libinput' 'libdrm' 'mesa' 'vulkan-icd-loader'
    'freetype2' 'harfbuzz' 'fontconfig' 'librsvg' 'cairo'
    'qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'layer-shell-qt'
    'pam' 'hicolor-icon-theme'
)
makedepends=('git' 'cmake' 'shaderc' 'vulkan-headers' 'wayland-protocols' 'qt6-tools')
optdepends=(
    'xorg-xwayland: X11 apps (Steam, many games)'
    'xdg-desktop-portal-wlr: screen sharing'
    'xdg-desktop-portal-kde: file chooser and other portals for apps'
    'polkit-kde-agent: the password prompt for system actions'
    'breeze-icons: Vela icons (breeze and breeze-dark)'
    'plasma-workspace: light or dark colors for KDE apps'
    'networkmanager: network and Wi-Fi (quick settings and Settings)'
    'bluez: Bluetooth'
    'wireplumber: volume'
    'libpulse: volume (pactl)'
    'power-profiles-daemon: energy saver'
    'udisks2: unmounted drives in File Explorer'
    'wlr-randr: Settings > Display'
    'xdg-utils: share by email, default apps'
    'kdeconnect: share with your phone'
    'bluedevil: share via Bluetooth'
    'konsole: il terminale (Win+Invio)'
)
provides=('vela')
conflicts=('vela')
backup=('etc/pam.d/vela-lock' 'etc/xdg/xdg-desktop-portal-wlr/Vela')
source=("$_name::git+${VELA_GIT_URL:-ssh://git@github.com/BrandoDev/vela.git}")
sha256sums=('SKIP')

pkgver() {
    cd "$_name"
    local version
    version=$(sed -n 's/^ *VERSION \([0-9.]*\)$/\1/p' CMakeLists.txt | head -n 1)
    printf "%s.r%s.g%s" "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
    # Le opzioni di compilazione le dà makepkg.conf (CMAKE_BUILD_TYPE=None).
    cmake -B build -S "$_name" \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBEXECDIR=lib/vela \
        -DVELA_BUILD_TOOLS=OFF \
        -Wno-dev
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm755 "$_name/packaging/arch/vela-update" "$pkgdir/usr/bin/vela-update"
}
