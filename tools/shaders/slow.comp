// vela-slowgpu's "rendering": a single group running long on a compute queue.
// Every step depends on the previous one, so the duration grows with the
// iterations and the compiler can't shorten it; the result goes into a buffer
// so the loop isn't removed.
#version 450

layout(local_size_x = 64) in;

layout(push_constant) uniform Push {
    uint iterations;
} push;

layout(std430, binding = 0) buffer Result {
    float value[64];
} result;

void main()
{
    float v = float(gl_LocalInvocationID.x) * 0.01;
    for (uint i = 0u; i < push.iterations; ++i) {
        v = fract(sin(v * 1.618 + 0.5) * 43758.5453);
    }
    result.value[gl_LocalInvocationID.x] = v;
}
