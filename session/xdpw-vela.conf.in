# xdg-desktop-portal-wlr inside Vela (screen sharing). When an app asks to
# share, Vela's shell shows what can be chosen: a whole output or a window,
# with previews. It answers "Monitor: <output>" or "Window: <identifier>", or
# nothing when cancelled.
[screencast]
chooser_type=simple
chooser_cmd=@CMAKE_INSTALL_FULL_BINDIR@/vela-shell --choose-source
