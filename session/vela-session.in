#!/bin/sh
# SPDX-FileCopyrightText: 2026 Brando Giuffrida
# SPDX-License-Identifier: GPL-3.0-or-later

# La sessione di Vela, avviata da SDDM (vela.desktop) o da una console.
# Il log di ogni sessione resta in ~/.local/state/vela/ (l'ultimo e il
# precedente), per capire cosa è successo se qualcosa va storto.

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/vela"
mkdir -p "$STATE_DIR"
[ -f "$STATE_DIR/vela.log" ] && mv -f "$STATE_DIR/vela.log" "$STATE_DIR/vela.log.old"

# --supervise: se il compositor va in crash si riavvia, e le app Qt e KDE
# si ricollegano (vedi compositor/src/supervisor.c).
exec "@CMAKE_INSTALL_FULL_BINDIR@/vela-compositor" --supervise -s "@CMAKE_INSTALL_FULL_BINDIR@/vela-shell" "$@" \
    2> "$STATE_DIR/vela.log"
